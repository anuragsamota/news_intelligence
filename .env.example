# --- Ollama backend -------------------------------------------------------------
# Local server by default. For Ollama Cloud use https://ollama.com plus OLLAMA_API_KEY.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=
NI_LLM_MODEL=qwen2.5:7b
NI_EMBEDDING_MODEL=nomic-embed-text
# NI_LLM_NUM_CTX=16384
# NI_LLM_CONCURRENCY=2          # match OLLAMA_NUM_PARALLEL on the server
# NI_LLM_TIMEOUT=300

# --- Extra sources (optional) - GDELT and Google News need no key ----------------
NEWSAPI_KEY=
TAVILY_API_KEY=

# --- Vector DB --------------------------------------------------------------------
# NI_VECTOR_BACKEND=auto        # auto | chroma | local | none
# NI_VECTOR_DB_PATH=.news_intelligence/vectordb

# --- Agent behaviour --------------------------------------------------------------
# NI_MAX_SUB_QUERIES=5
# NI_MAX_ITERATIONS=2
